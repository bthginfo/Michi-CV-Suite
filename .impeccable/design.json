    {
      "name": "Editor field",
      "kind": "input",
      "refersTo": "field",
      "description": "Standard labeled editor field with source focus treatment.",
      "html": "<label class=\"ds-field\"><span>Titel</span><input value=\"Berufserfahrung\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;font-family:\"DM Sans Variable\",\"DM Sans\",sans-serif;color:#9aacca;font-size:9px;line-height:1.5}.ds-field input{width:100%;min-width:0;border:1px solid #ffffff12;border-radius:6px;background:#0b1527;color:#c4d1e7;padding:10px 11px;font-family:inherit;font-size:10px;line-height:1.5;transition:border-color .15s}.ds-field input:focus-visible{outline:none;border-color:#8da8ef;box-shadow:0 0 0 3px #a8bfff10}"
    },
    {
      "name": "Orbit gallery card",
      "kind": "card",
      "refersTo": "template-card",
      "description": "Family-specific rounded-board miniature; an outline rather than a live document render.",
      "html": "<button class=\"ds-template\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-mini\"><span class=\"ds-mini-identity\"><strong>Michael Meier</strong><i></i></span><span class=\"ds-mini-panels\"><i></i><i></i><i></i><i></i></span></span><span class=\"ds-template-name\">Orbit</span></button>",
      "css": ".ds-template{width:128px;border:0;padding:0;text-align:left;background:transparent;color:#d2dfff;font-family:\"DM Sans Variable\",\"DM Sans\",sans-serif;cursor:pointer}.ds-mini{box-sizing:border-box;display:block;height:154px;padding:6%;border:2px solid #b6c9ff;border-radius:5px;background:#eef2f8;color:#172d4a;box-shadow:0 0 0 2px #a8bfff0c,0 5px 18px #0003;transition:border-color .18s,transform .18s}.ds-template:hover .ds-mini{transform:translateY(-2px)}.ds-template:focus-visible{outline:2px solid var(--accent,#b4c7ff);outline-offset:4px}.ds-mini-identity{display:block;min-height:23%;margin:0 0 5%;padding:7% 6% 6% 30%;border:.7px solid #d6e0ed;border-radius:6px;background:#fff}.ds-mini-identity strong{display:block;font-size:7.1px;font-weight:740;line-height:1.02;letter-spacing:-.035em;overflow-wrap:anywhere}.ds-mini-identity i{display:block;width:88%;height:1.8px;margin-top:4px;background:#2667c9;opacity:.75}.ds-mini-panels{display:grid;grid-template-columns:1fr 1fr;gap:4px}.ds-mini-panels>i{display:block;min-height:20px;padding:4px 5px;border:.7px solid #d6e0ed;border-radius:5px;background:#fff}.ds-mini-panels>i:nth-child(-n+2){grid-column:1/-1}.ds-template-name{display:block;font-size:11px;font-weight:500;margin-top:8px;padding-left:1px}@media(prefers-reduced-motion:reduce){.ds-mini{transition:none}}"
    },
    {
      "name": "Orbit document panel",
      "kind": "custom",
      "refersTo": "orbit-panel",
      "description": "Rounded real-section material on Orbit board paper.",
      "html": "<div class=\"ds-orbit-board\"><section class=\"ds-orbit-panel\"><h3>Berufserfahrung</h3><p>Abschnittsinhalt aus dem CV</p></section></div>",
      "css": ".ds-orbit-board{padding:16px;background:#eef2f8;color:#172d4a;font-family:\"DM Sans Variable\",\"DM Sans\",sans-serif}.ds-orbit-panel{padding:19px;border:1px solid color-mix(in srgb,#2667c9 15%,#dfe7ef);border-radius:18px;background:#fff}.ds-orbit-panel h3{margin:0 0 13px;font-size:13px;font-weight:720;line-height:1.35;letter-spacing:-.012em}.ds-orbit-panel p{margin:0;color:#4a607b;font-size:12.2px;line-height:1.48}"
    },
    {
