  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Pale blue action for PDF download, saving a dialog or copying a share link.",
      "html": "<button class=\"ds-primary\" type=\"button\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3\"/></svg>PDF herunterladen</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:37px;padding:10px 15px;border:1px solid transparent;border-radius:8px;font-family:\"DM Sans Variable\",\"DM Sans\",sans-serif;font-size:11px;line-height:1.25;font-weight:550;white-space:nowrap;cursor:pointer;transition:background .18s,color .18s,border-color .18s,box-shadow .18s,transform .18s;color:#142039;background:#bccdff;border-color:#d2ddff;box-shadow:0 2px 6px #0001,0 1px 0 #ffffff25 inset}.ds-primary:hover:not(:disabled){background:#d1ddff;box-shadow:0 3px 16px #b4c7ff15;transform:translateY(-1px)}.ds-primary:focus-visible{outline:2px solid var(--accent,#b4c7ff);outline-offset:4px;}.ds-primary:disabled{opacity:.35;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered secondary action in the navy working shell.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Abbrechen</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:37px;padding:10px 15px;border:1px solid transparent;border-radius:8px;font-family:\"DM Sans Variable\",\"DM Sans\",sans-serif;font-size:11px;line-height:1.25;font-weight:550;white-space:nowrap;cursor:pointer;transition:background .18s,color .18s,border-color .18s,box-shadow .18s,transform .18s;color:#cbd5e8;border-color:#ffffff16;background:#ffffff03}.ds-secondary:hover:not(:disabled){border-color:#ffffff28;background:#ffffff09}.ds-secondary:focus-visible{outline:2px solid var(--accent,#b4c7ff);outline-offset:4px;}.ds-secondary:disabled{opacity:.35;cursor:default}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Navigation rail item",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Icon and label in the desktop navigation rail, with the selected edge marker.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Studio\"><button class=\"ds-nav ds-nav-active\" type=\"button\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m16 3 5 5M4 20l4-1L21 6a2.1 2.1 0 0 0-3-3L5 16z\"/></svg><span>Inhalte</span></button></nav>",
      "css": ".ds-rail{width:76px;padding:8px;background:#0d1729}.ds-nav{position:relative;width:100%;display:flex;flex-direction:column;align-items:center;gap:8px;padding:11px 3px 9px;border:0;border-radius:10px;color:#7c8eac;background:transparent;cursor:pointer;font-family:\"DM Sans Variable\",\"DM Sans\",sans-serif}.ds-nav>span{font-size:9px;font-weight:500}.ds-nav:hover{color:#cad6ed;background:#ffffff04}.ds-nav-active{color:#b8ccff;background:#a8bfff0b}.ds-nav-active:before{content:\"\";position:absolute;width:2px;height:22px;left:-8px;top:11px;background:#aec4ff;border-radius:0 3px 3px 0}.ds-nav:focus-visible{outline:2px solid var(--accent,#b4c7ff);outline-offset:4px;}"
    },
    {
      "name": "Symbol category chip",
      "kind": "chip",
      "refersTo": "category-chip",
      "description": "Wrapping German icon category filters, selected and idle.",
      "html": "<div class=\"ds-categories\" aria-label=\"Symbolkategorien\"><button type=\"button\" class=\"ds-chip ds-chip-selected\" aria-pressed=\"true\">Alle</button><button type=\"button\" class=\"ds-chip\" aria-pressed=\"false\">Technik &amp; Werkzeuge</button></div>",
      "css": ".ds-categories{display:flex;flex-wrap:wrap;gap:6px}.ds-chip{padding:7px 9px;min-height:33px;font-family:\"DM Sans Variable\",\"DM Sans\",sans-serif;font-size:10px;line-height:1.4;color:#a0b2cc;border:1px solid #ffffff12;border-radius:6px;background:transparent;cursor:pointer}.ds-chip:hover{background:#ffffff08;color:#e4ecfb}.ds-chip-selected{background:#b6c9ff13;border-color:#aec6ff55;color:#ccdaff}.ds-chip:focus-visible{outline:2px solid var(--accent,#b4c7ff);outline-offset:4px;}"
