{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "functions":{"api/workspace.ts":{"maxDuration":30},"api/pdf.ts":{"maxDuration":60,"includeFiles":"node_modules/@sparticuz/chromium/bin/**"}},
  "headers":[{"source":"/(.*)","headers":[
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
  ]}],
  "rewrites":[{"source":"/((?!api/|assets/|favicon.svg).*)","destination":"/index.html"}]
}
